datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id            String      @id @default(uuid())
    robloxId      BigInt      @unique
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    bannedAt      DateTime?
    banReason     String?
    banExpiresAt  DateTime?
    isAdmin       Boolean     @default(false)
    metadata      Json?
    purchases     Purchase[]
}

model Purchase {
    id          String      @id @default(uuid())
    user        User        @relation(fields: [userId], references: [id])
    userId      String
    productId   BigInt
    priceRobux  Int
    purchasedAt DateTime    @default(now())
    metadata    Json?
}

// Deliberately standalone (no relation to User) so it can be created from just a
// Roblox ID, with no dependency on a User row (and therefore a username) existing first.
model PlayerStats {
    robloxId          BigInt      @id
    level             Int         @default(1)
    gold              String      @default("0;0")
    highestLevel      Int         @default(1)
    selectedLevel     Int         @default(1)
    progress          Int         @default(0)
    totalBlocksMined  Int         @default(0)
    createdAt         DateTime    @default(now())
    updatedAt         DateTime    @updatedAt
}
