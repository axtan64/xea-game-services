datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

// Encapsulates a game using this backend.
model Game {
    id                    String            @id @default(uuid())
    slug                  String            @unique
    name                  String
    gatewayTokenHash      String            @unique
    robloxUniverseId      BigInt?
    robloxOpenCloudApiKey String?
    createdAt             DateTime          @default(now())
    updatedAt             DateTime          @updatedAt
    memberships           GameMembership[]
    purchases             Purchase[]
}

// A Roblox account's identity
model User {
    id                String            @id @default(uuid())
    robloxId          BigInt            @unique
    createdAt         DateTime          @default(now())
    updatedAt         DateTime          @updatedAt
    metadata          Json?
    purchases         Purchase[]        @relation("PurchaseUser")
    receivedPurchases Purchase[]        @relation("PurchaseRecipient")
    memberships       GameMembership[]
}

// Per-(game, user) moderation/role state
model GameMembership {
    id           String    @id @default(uuid())
    game         Game      @relation(fields: [gameId], references: [id])
    gameId       String
    user         User      @relation(fields: [userId], references: [id])
    userId       String
    isAdmin      Boolean   @default(false)
    bannedAt     DateTime?
    banReason    String?
    banExpiresAt DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    @@unique([gameId, userId])
}

model Purchase {
    id              String   @id @default(uuid())
    game            Game     @relation(fields: [gameId], references: [id])
    gameId          String
    user            User     @relation("PurchaseUser", fields: [userId], references: [id])
    userId          String
    recipient       User?    @relation("PurchaseRecipient", fields: [recipientId], references: [id])
    recipientId     String?
    productId       BigInt
    productType     String   @default("devproduct") // 'gamepass' | 'devproduct'
    priceRobux      Int
    robloxReceiptId String?  @unique // Roblox ProcessReceipt's PurchaseId - idempotency key; null for non-receipted (e.g. admin) grants
    purchasedAt     DateTime @default(now())
    metadata        Json?

    @@index([recipientId])
}

// User Data for Xea's Mining Game
model MiningPlayerStats {
    robloxId            BigInt   @id
    level               Int      @default(1)
    gold                String   @default("0;0")
    gems                String   @default("0;0")
    unobtanium          String   @default("0;0")
    highestLevel        Int      @default(1)
    progress            Int      @default(0)
    progressLevel       Int      @default(1)
    totalBlocksMined    String   @default("0;0")
    heroIndex           Int      @default(0)
    heroLevels          Json     @default("{}")
    heroUpgrades        Json     @default("{}")
    lifetimeDamage      String   @default("0;0")
    timePlayed          Int      @default(0)
    achievementLevels   Json     @default("{}")
    settings            Json     @default("{}")
    objectivesCompleted Int      @default(0)
    mealsEaten          Int      @default(0)
    lastMealEatenAt     Int      @default(0)
    pendingUnobtanium   String   @default("0;0")
    lifetimeUnobtanium  String   @default("0;0")
    lifeLength          Int      @default(0)
    ascensionCount      Int      @default(0)
    levelToken          Int      @default(0)
    boardUpgrades       Json     @default("{}")
    ownedProducts       Json     @default("{}")
    upgradeTree         Json     @default("{}")
    unlockedAreas        Json     @default("{}")
    hasVisitedMiningArea Boolean  @default(false)
    seenTutorials        Json     @default("{}")
    cube                 String   @default("0;0")
    lifetimeCube         String   @default("0;0")
    megaCubesCollected   String   @default("0;0")
    createdAt            DateTime @default(now())
    updatedAt           DateTime @updatedAt
}

// User Data for Xea's Donation Game
model DonationPlayerStats {
    robloxId       BigInt   @id
    credits        Int      @default(0)
    unclaimedRobux Int      @default(0)
    robuxRaised    Int      @default(0)
    robuxDonated   Int      @default(0)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

// User Data for Clean Up The City (slug: cutc)
model CutcPlayerStats {
    robloxId      BigInt   @id
    timePlayed     Int      @default(0)
    settings       Json     @default("{}")
    ownedProducts  Json     @default("{}")
    // Per account until save slots exist; the brief moves cash into the leader's save slot later
    cash           Float    @default(0)
    contractTokens Int      @default(0)
    // Unused since 2026-11-18: the litter index is the save slot's, shared by its players
    litterIndex    Json     @default("{}")
    // { [classId]: count }
    classes        Json     @default("{}")
    // "" when none is equipped
    equippedClass  String   @default("")
    // Easter eggs found, kept for good across cities: { [eggId]: true }
    easterEggs     Json     @default("{}")
    // Ever, in every city: litter picked up, tiles whose last piece the player took, and dollars their selling earned
    litterPickedUp Int      @default(0)
    tilesCleaned   Int      @default(0)
    cashEarned     Float    @default(0)
    // The cosmetics worn: { [slot]: cosmeticId }
    cosmetics      Json     @default("{}")
    // The player's own contracts, every six hours, and the daily streak: { period, tasks, progress, streak, lastDay, best }
    dailies        Json     @default("{}")
    // Things the player has seen once, so they stop being pointed out (the shop's dot): { [thingId]: true }
    seen           Json     @default("{}")
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([tilesCleaned])
    @@index([cashEarned])
}

// One of a player's save slots in Clean Up The City: a whole city, played by one game server at a time
model CutcSaveSlot {
    id           String    @id @default(uuid())
    ownerId      BigInt
    // 1 to 3
    slot         Int
    // The save the game's SaveCodec reads and writes, opaque here; null until the first save
    data         Json?
    // Counts saves, so a backup copy can be told from a newer one
    version      Int       @default(0)
    // A summary for the lobby's slot picker, written with each save
    cleanShare   Float     @default(0)
    cash         Float     @default(0)
    partySize    Int       @default(1)
    // Seconds the city has been played, counted while anyone is in it
    playTime     Int       @default(0)
    // The play time at which the city met its last Depot milestone, for the lobby's fastest cities; null until
    // then, and for a city where an admin skipped one
    finishedIn   Int?
    lastPlayedAt DateTime?
    // The session lock: the server playing the slot, and when it last said so (saves and heartbeats refresh it)
    lockId       String?
    lockedAt     DateTime?
    // The live session, written by the server that holds the lock: its reserved server's ID and the access code
    // the lobby reserved it with (copied from its CutcParty), so others can be sent into a city already in play;
    // and who is in it, refreshed with each save and heartbeat, with the most it may hold (more with the owner's
    // 100-player pass)
    serverId     String?
    accessCode   String?
    playerCount  Int       @default(0)
    maxPlayers   Int       @default(8)
    ownerPresent Boolean   @default(false)
    // Who is in it, as Roblox user IDs (strings), so an admin's /join can find the city a player is in: a city's
    // reserved server can't be found from the player's own server
    players      Json      @default("[]")
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    @@unique([ownerId, slot])
    @@index([cleanShare])
    @@index([finishedIn])
}

// Who may join a Clean Up The City save slot besides its owner. Kept apart from CutcSaveSlot so wiping a slot
// keeps its sharing, and so a slot can be set up before it is ever played
model CutcSlotAccess {
    id         String   @id @default(uuid())
    ownerId    BigInt
    slot       Int
    // Nobody, Invited (its members) or Friends (the owner's Roblox friends, and its members)
    access     String   @default("Friends")
    // Whether they may play the city while its owner isn't in it
    allowAway  Boolean  @default(false)
    // Entering this makes a player a member; null until the owner asks for one
    inviteCode String?  @unique
    // Roblox user IDs, as strings
    members    Json     @default("[]")
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([ownerId, slot])
}

// A party on its way from Clean Up The City's lobby to the reserved server that will play a save slot
model CutcParty {
    // The reserved server's ID (game.PrivateServerId)
    serverId  String   @id
    ownerId   BigInt
    slot      Int
    // Roblox user IDs allowed in, the owner included
    members    Json     @default("[]")
    // The code the lobby reserved the server with: what a later teleport into it needs
    accessCode String?
    createdAt  DateTime @default(now())

    @@index([ownerId, slot])
}

// Permanent ledger of Robux donations between players in the donation game
model Donation {
    id           String    @id @default(uuid())
    fromRobloxId BigInt
    toRobloxId   BigInt
    amount       Int
    message      String?
    claimedAt    DateTime?
    createdAt    DateTime  @default(now())

    @@index([toRobloxId])
    @@index([fromRobloxId])
}

// Live-rotatable key/value config (e.g. ROBLOX_BOT_COOKIE), edited via the admin dashboard
// without a redeploy/restart. Value is stored as plain text - callers are responsible for
// treating sensitive values as secrets (never logged, never returned unmasked to a UI that
// doesn't need the raw value).
model Setting {
    key       String   @id
    value     String
    updatedAt DateTime @updatedAt
}

// A "like" from one player to another in the mining game
model MiningLike {
    id        String   @id @default(uuid())
    userId    BigInt
    likingId  BigInt
    createdAt DateTime @default(now())

    @@unique([userId, likingId])
    @@index([likingId])
}

// A "like" from one player to another in Clean Up The City (the player card's Like Player), apart from the
// mining game's
model CutcLike {
    id        String   @id @default(uuid())
    userId    BigInt
    likingId  BigInt
    createdAt DateTime @default(now())

    @@unique([userId, likingId])
    @@index([likingId])
}