DISCORD_TOKEN= # Bot token for the Discord application
DISCORD_CLIENT_ID= # That bot's application/client ID
ROBLOX_BOT_COOKIE= # .ROBLOSECURITY cookie for a Roblox account with access to the group's funds page (seed only - rotate it afterwards through the admin dashboard, not by editing this file)
PROXIES= # comma-separated host:port:username:password entries (e.g. Webshare's proxy list export). (empty = no proxies)

# --- Admin dashboard (services/dashboard) ---
ROBLOX_OAUTH_CLIENT_ID= # From the Roblox Creator Dashboard's OAuth 2.0 Apps page
ROBLOX_OAUTH_CLIENT_SECRET= # Same page - keep this secret
ROBLOX_OAUTH_REDIRECT_URI= # Must exactly match a redirect URL registered on that app, e.g. https://dashboard.yourdomain.com/auth/callback
DASHBOARD_SESSION_SECRET= # Random string used to sign the dashboard's session cookie - generate with: openssl rand -hex 32