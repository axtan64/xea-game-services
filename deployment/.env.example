ROBLOX_AUTH= # bearer token Roblox game servers authenticate to the gateway with - keep this secret
DISCORD_WEBHOOK_URL= # Discord webhook URL the discord-webhook service posts embeds to - keep this secret
ROBLOX_UNIVERSE_ID= # Universe ID of the game to publish MessagingService announcements to
ROBLOX_OPEN_CLOUD_API_KEY= # Open Cloud API key with messaging-service:publish permission for that universe - keep this secret
