PORT=3006 # Port of the discord-webhook server
DISCORD_WEBHOOK_URL= # Discord channel webhook URL, e.g. https://discord.com/api/webhooks/{id}/{token}
DISCORD_EMOJI_ROBUX= # Full custom emoji code for :robux:, e.g. <:robux:123456789012345678> - type \:robux: in your Discord server and send to reveal it
DISCORD_EMOJI_VERIFIED= # Full custom emoji code for :verified:, same trick: type \:verified: in Discord and send to reveal it
