PORT=3006
DATABASE_URL=postgresql://mining:mining@localhost:5432/mining

# From the Roblox Creator Dashboard's OAuth 2.0 Apps page
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URL registered on that app
ROBLOX_OAUTH_REDIRECT_URI=http://localhost:3006/auth/callback
# Who's allowed to sign in, and their rank label, is hardcoded in server/lib/admins.js (not an env var)
# Random string used to sign the session cookie - generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
