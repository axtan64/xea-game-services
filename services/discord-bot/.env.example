PORT=3002 # Port of the discord-bot server

DISCORD_TOKEN= # Bot token for the Discord application (same bot used by the chatxea repo)
DISCORD_CLIENT_ID= # That bot's application/client ID

# Channel IDs the bot posts embeds to
TRACK_CHANNEL_ID= # Notable player joins
PURCHASE_CHANNEL_ID= # Gamepass/dev product purchases
TUNNEL_CHANNEL_ID= # Cloudflare tunnel URL changes
FUNDS_CHANNEL_ID= # Scheduled group-funds reports (see /funds command)

# Roblox group whose funds the /funds command and scheduled post report on
ROBLOX_GROUP_ID=13952572

# .ROBLOSECURITY cookie for a Roblox account with access to the group's funds page (seed only -
# once the dashboard is running, rotate it from /settings instead of editing this file)
ROBLOX_BOT_COOKIE=

# Needed so lib/credentials.js can read the live-rotated cookie from the Setting table
DATABASE_URL= # postgresql://user:password@host:5432/db

# ChatXea chat bot functionality
OPENAI_API_KEY=
GROQ_API_KEY=